# ============================================================================
# Aegis AI — Environment Configuration
# Copy this file to .env and update values for your environment.
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=aegis-ai
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-secure-random-string
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aegis_ai
DATABASE_USER=aegis
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Qdrant Vector Database ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=aegis_knowledge

# ── MinIO Object Storage ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=aegis-documents
MINIO_USE_SSL=false

# ── AI Models ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-2.0-flash

GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.1-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

DEFAULT_LLM_PROVIDER=openai

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Integrations ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-ai-api

# ── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AUTONOMOUS_MODE=false
FEATURE_MULTI_MODEL=true
FEATURE_STREAMING=true
